{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "NETT-skrl (Isaac Lab) Config Schema",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the folder the results of the run will output into",
      "type": "string"
    },
    "brain": {
      "type": "object",
      "properties": {
        "encoder": {
          "description": "NETTFeatureExtractor name or subclass.",
          "anyOf": [
            { "type": "string" },
            { "not": { "type": "string" } }
          ],
          "default": "small"
        },
        "algorithm": {
          "description": "skrl agent class name from the algorithm registry.",
          "anyOf": [
            { "type": "string" },
            { "not": { "type": "string" } }
          ],
          "default": "PPO"
        },
        "reward": {
          "description": "Environment reward string or registered intrinsic reward.",
          "anyOf": [
            { "type": "string" },
            { "not": { "type": "string" } }
          ],
          "default": "closeness"
        },
        "evaluation_policy": {
          "description": "Evaluation-time action source. 'agent' uses the trained policy; 'target_side_oracle' steers toward the design-sheet target monitor during test rollouts.",
          "type": "string",
          "enum": ["agent", "target_side_oracle"],
          "default": "agent"
        },
        "checkpoint_freq":       { "type": ["integer", "null"], "minimum": 1, "default": null },
        "encoder_cfg": {
          "type": "object",
          "properties": {
            "features_dim": { "type": "integer", "minimum": 1, "default": 512 },
            "trainable": { "type": "boolean", "default": true }
          },
          "additionalProperties": true,
          "default": { "features_dim": 512, "trainable": true }
        },
        "algorithm_cfg": {
          "type": "object",
          "properties": {
            "learning_rate": {
              "anyOf": [ { "type": "number", "minimum": 0 }, { "not": { "type": "string" } } ],
              "default": 1e-5
            },
            "rollouts": { "type": "integer", "minimum": 1, "default": 8000 },
            "mini_batches": { "type": "integer", "minimum": 1, "default": 16 },
            "value_loss_scale": { "type": ["number", "null"], "default": 0.25 },
            "grad_norm_clip": { "type": ["number", "null"], "default": 0.25 },
            "batch_size": { "type": "integer", "minimum": 1, "default": 64 },
            "memory_size": { "type": "integer", "minimum": 1, "default": 8000 },
            "gradient_steps": { "type": ["integer", "null"], "minimum": 1, "default": null },
            "learning_starts": { "type": ["integer", "null"], "minimum": 0, "default": null }
          },
          "additionalProperties": true,
          "default": {
            "learning_rate": 1e-5,
            "rollouts": 8000,
            "mini_batches": 16,
            "value_loss_scale": 0.25,
            "grad_norm_clip": 0.25
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "hidden_sizes": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "default": [64, 64] },
            "activation": { "type": "string", "enum": ["elu", "relu", "tanh"], "default": "elu" },
            "initial_log_std": { "type": "number", "default": 0.0 },
            "max_log_std": { "type": ["number", "null"], "default": null },
            "clip_actions": { "type": "boolean", "default": true },
            "value_bound": { "type": ["number", "null"], "default": 10.0 },
            "orthogonal_init": { "type": "boolean", "default": true },
            "hidden_gain": { "type": "number", "exclusiveMinimum": 0, "default": 1.4142135623730951 },
            "output_gain": { "type": "number", "exclusiveMinimum": 0, "default": 0.01 },
            "shared_encoder": { "type": "boolean", "default": false },
            "actor_distribution": { "type": ["string", "null"], "enum": ["gaussian", "multivariate_gaussian", null], "default": null }
          },
          "additionalProperties": false,
          "default": {}
        },
        "reward_cfg": {
          "type": "object",
          "properties": {
            "beta": { "type": "number", "default": 0.2 },
            "kappa": { "type": "number", "default": 0.0 },
            "gamma": { "type": "number", "default": 0.99 },
            "weight": { "type": "number", "default": 1.0 },
            "trainable": { "type": "boolean", "default": true }
          },
          "additionalProperties": true,
          "default": { "beta": 0.2, "kappa": 0.0, "gamma": 0.99, "weight": 1.0, "trainable": true }
        },
        "wandb": {
          "description": "Weights & Biases logging. skrl's native integration creates one wandb run per agent (per brain).",
          "type": "object",
          "properties": {
            "project": { "type": "string", "default": "nett-skrl" },
            "entity":  { "type": ["string", "null"], "default": null,
                         "description": "wandb entity (team/user). null = use the WANDB_ENTITY env var or default account." },
            "mode":    { "type": "string", "enum": ["online", "offline", "disabled"], "default": "online",
                         "description": "online = upload; offline = local only; disabled = skip wandb entirely." },
            "tags":    { "type": "array", "items": { "type": "string" }, "default": [],
                         "description": "Extra wandb tags appended to the auto-tags (run/condition/brain/phase)." },
            "notes":   { "type": ["string", "null"], "default": null },
            "kwargs": {
              "type": "object",
              "default": {},
              "description": "Additional wandb.init kwargs passed through skrl. NETT-owned run layout keys take precedence."
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "body": {
      "description": "Agent body settings. Prefer this block for observation wrappers and perception-side overrides.",
      "type": "object",
      "properties": {
        "wrappers": {
          "description": "Optional observation transforms; names come from the body wrapper registry.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "anyOf": [
              { "type": "string" },
              { "not": { "type": "string" } }
            ]
          },
          "default": []
        },
        "input_resolution": { "type": ["integer", "null"], "minimum": 16, "default": null }
      },
      "additionalProperties": false,
      "default": {}
    },
    "environment": {
      "type": "object",
      "properties": {
        "experiment":       { "type": "string",
                              "description": "Self-contained experiment bundle: a directory (or .zip) with a design CSV + its videos. Overrides design_sheet/media_root — the drop-in way to swap experiments." },
        "design_sheet":     { "type": "string",
                              "description": "Path to design CSV (replaces Unity AssetBundles). Not needed when `experiment` is set." },
        "media_root":       { "type": "string",
                              "description": "Directory containing video/PNG stimulus assets. Not needed when `experiment` is set." },
        "conditions":       { "type": ["array", "null"], "uniqueItems": true,
                              "items": { "type": "string" }, "default": null },
        "headless":         { "type": "boolean", "default": true },
        "input_resolution": { "type": "integer", "minimum": 16, "default": 64 },
        "camera_fov":       { "type": "number", "minimum": 10, "maximum": 200, "default": 120.0 },
        "record_mode":      { "type": "string", "enum": ["tSNE", "spatial"], "default": "tSNE" },
        "random_first_frame": { "type": "boolean", "default": false },
        "decision_period":  { "type": "integer", "minimum": 1, "default": 1 },
        "enable_neck_flexion": { "type": "boolean", "default": true },
        "enable_lateral_bending": { "type": "boolean", "default": true },
        "locomotion": { "type": "string", "enum": ["kinematic", "wheeled"], "default": "kinematic" },
        "recording": {
          "type": "object",
          "properties": {
            "fps": { "type": "integer", "minimum": 1, "default": 24 },
            "egocentric": { "$ref": "#/$defs/recordingSection" },
            "chamber": { "$ref": "#/$defs/recordingSection" }
          },
          "additionalProperties": false,
          "default": {}
        },
        "reward_types": {
          "description": "NETTEnv reward names; validated against the registry.",
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "render_mode": {
          "description": "Isaac Sim RTX render mode. RealTimeRenderer = rasterizer (no ray tracing, lowest GPU cost). RayTracingLighting = hardware RT (Isaac default). PathTracing = full path trace (slowest). Empty string leaves Isaac's built-in default in place.",
          "type": "string",
          "enum": ["RealTimeRenderer", "RayTracingLighting", "PathTracing", ""],
          "default": "RealTimeRenderer"
        },
        "tracemalloc_interval": {
          "description": "Debug: take a Python heap snapshot every N simulation steps and log the top allocators to stdout. 0 = disabled. Useful for diagnosing per-step memory growth; negligible overhead when disabled.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "train_step_logging": {
          "description": "Per-step CSV logging during the train phase. Default false: the per-step _log_step_batch GPU->CPU sync + O(num_envs) host loop is the dominant per-step CPU handover, and analyze() reads only the TEST CSVs + tfevents (never the train CSV), so disabling it speeds up (esp. highly-parallel) training with no effect on learning or the rest score. Set true to restore the diagnostic per-step train trajectory CSV.",
          "type": "boolean",
          "default": false
        }
      },
      "anyOf": [
        { "required": ["experiment"] },
        { "required": ["design_sheet", "media_root"] }
      ],
      "additionalProperties": false
    },
    "episodes": {
      "type": "object",
      "properties": {
        "train": { "type": "integer", "minimum": 0, "default": 5000 },
        "test":  { "type": "integer", "minimum": 0, "default": 100 },
        "record": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "steps_per_episode": { "type": "integer", "minimum": 1, "default": 200 },
    "num_brains":        { "type": "integer", "minimum": 1, "default": 1 },
    "max_parallel_envs": { "description": "Optional per-condition-task cap for total vectorized env rows. task_memory: auto may search downward from this cap.",
                           "type": ["integer", "null"], "minimum": 1, "default": null },
    "brain_id_offset":   { "type": "integer", "minimum": 0, "default": 0 },
    "eval_freq":         { "type": ["integer", "null"], "minimum": 1, "default": null },
    "task_memory":       { "description": "GB per task; \"auto\" runs dry-run profiling to estimate.",
                           "oneOf": [
                             { "type": "number", "minimum": 0 },
                             { "type": "string", "enum": ["auto"] }
                           ],
                           "default": "auto" }
  },
  "patternProperties": {
    "^\\$": { "type": "string" }
  },
  "$defs": {
    "recordingSection": {
      "description": "Per-camera recording config. Each phase key (train/test/record) holds an episode selector. Omitting a phase records nothing for that phase; omitting the whole camera block records nothing for that camera. Selector formats: slice string 'start:stop:step' (Python-slice semantics, '0:5' = episodes 0..4); integer N = episode N only; integer list = those exact episode indices; null = every episode in that phase.",
      "type": "object",
      "properties": {
        "train":  { "$ref": "#/$defs/episodeSelector" },
        "test":   { "$ref": "#/$defs/episodeSelector" },
        "record": { "$ref": "#/$defs/episodeSelector" }
      },
      "additionalProperties": false,
      "default": {}
    },
    "episodeSelector": {
      "type": ["string", "integer", "array", "null"],
      "items": { "type": "integer", "minimum": 0 }
    }
  },
  "required": ["name", "environment"],
  "additionalProperties": false
}
