#!/usr/bin/env bash
# Block a push whose tests do not pass.
#
# WHY A HOOK. There is no CI in this repo, so "run the suite" is a command someone has to
# remember. In the sibling repoA that failed: three chamber tests sat RED for weeks because
# nothing ever ran them. This repo had no hook at all until 2026-07-27, which made it the
# remaining half of that same gap.
#
# WHAT THIS HOOK OWNS. Everything the suite needs that a `git clone` does not carry, because
# that is where "passes on my machine, fails on yours" actually comes from. Three things,
# and none of them were handled until 2026-07-29:
#   * the INTERPRETER -- discovered and probed, not hardcoded (see below);
#   * the NATIVE LIBS -- libGLU, which lives outside every repo;
#   * the EXTERNAL PREREQUISITES -- built assets and the compiled frame cache, delegated to
#     scripts/prepare_test_env.py so the hook and the tests share one source of truth.
#
#   * the RESIDENT LIBRARY -- torch loads a libstdc++ into the process before isaacsim asks
#     for one, and if that copy is too old the Kit bootstrap fails, the e2e tree marks itself
#     skip, and the leg exits 0 in under two seconds. See the LD_PRELOAD block in the e2e
#     section: on chicken, EVERY green e2e line this hook ever printed was that.
#
# ⛔ AND THE RULE THAT FOLLOWS FROM IT: a gate that reports success without executing is worse
# than no gate, because it also retires the suspicion that would have caught it. `e2e_verdict`
# below therefore COUNTS what ran and refuses loudly when the answer is "nothing", and the
# NETT_SKIP_E2E path says so in the final line instead of printing a bare OK.
#
# Install with:  scripts/install_git_hooks.sh
# Self-test:     scripts/hooks/pre-push --self-test [python]   (no repo, no GPU, no push)
# Bypass once:   NETT_SKIP_HOOKS=1 git push        (or git push --no-verify)
# Skip e2e only: NETT_SKIP_E2E=1 git push          (unit suite still runs; the hook SAYS so)
# Long push:     GIT_SSH_COMMAND='ssh -o ServerAliveInterval=60 -o ServerAliveCountMax=30' git push
#     The e2e leg idles the push's ALREADY-OPEN socket for ~15 minutes, and without keepalives
#     the push can die at exit 141 (SIGPIPE) AFTER this hook prints OK, with nothing pushed.
#     ⚠ THE HOOK CANNOT SET THIS FOR THE PUSH THAT IS INVOKING IT -- git chose the transport and
#     opened the connection before the hook ran, so an export here would be a silent no-op. It
#     can only advise, and it does, in the e2e section, when `ssh -G` says keepalives are off.
set -uo pipefail

[ -n "${NETT_SKIP_HOOKS:-}" ] && { echo "pre-push: skipped (NETT_SKIP_HOOKS)"; exit 0; }

# --- testable detectors ---------------------------------------------------------------
# ⛔ A GATE THAT CANNOT BE TESTED WITHOUT A PUSH GETS TESTED BY PUSHING, and this one then
# reported OK over an e2e leg that never executed. Everything below is a pure function of its
# arguments so that `scripts/hooks/pre-push --self-test` can exercise it on synthetic inputs --
# including the branch that must NOT fire. Run it after editing this file.

_has_glibcxx_3_4_30() {
  # Does this libstdc++ provide the version isaacsim's libcarb.so asks for?
  # ⚠ THE LITERAL IS A MEASUREMENT, NOT A GUESS: the bootstrap failure names it verbatim --
  # "version `GLIBCXX_3.4.30' not found (required by .../isaacsim/kit/libcarb.so)". A
  # libstdc++ carries every version it provides as a plain string, so grep answers exactly the
  # question the dynamic loader will ask. `strings` would read better and is not installed
  # everywhere; grep -a is.
  [ -e "$1" ] && LC_ALL=C grep -aqE 'GLIBCXX_3\.4\.30' "$1" 2>/dev/null
}

_mapped_libstdcxx() {
  # Which libstdc++ this interpreter ACTUALLY ends up with, asked of the interpreter itself.
  # ⛔ NOT a guess from a path, and NOT "is there a conda in $PATH". torch loads libstdc++ into
  # the process before isaacsim asks for one, and no path variable moves a library that is
  # already resident -- so the only honest question is which file got mapped, and /proc/self/maps
  # is where the answer is. Empty output means "could not tell", which is a third answer and is
  # treated as one by the caller.
  "$1" -c '
import sys
try:
    import torch  # noqa: F401  -- torch is what pulls libstdc++ in; that IS the mechanism
except Exception:
    sys.exit(0)
try:
    for line in open("/proc/self/maps"):
        if "libstdc++" in line:
            print(line.rsplit(" ", 1)[-1].strip()); break
except OSError:
    pass' 2>/dev/null
}

_system_libstdcxx() {
  # The newest libstdc++ the SYSTEM offers that actually provides the symbol. ldconfig is the
  # loader's own answer and is distro-agnostic; the two literal paths are the fallback for a
  # host whose cache is stale. Prints nothing and returns 1 when the system cannot help, which
  # is a real state on a host that simply does not have a new enough libstdc++.
  local cand
  for cand in "$(ldconfig -p 2>/dev/null | awk '/libstdc\+\+\.so\.6 /{print $NF; exit}')" \
              /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib64/libstdc++.so.6; do
    if [ -n "$cand" ] && _has_glibcxx_3_4_30 "$cand"; then printf '%s' "$cand"; return 0; fi
  done
  return 1
}

e2e_jobs_for_plugin() {
  # $1 = the job count the GPUs justify, $2 = 1 if pytest-xdist is importable. Prints the count
  # to actually use.
  #
  # ⚠ WITHOUT THE PLUGIN, `-n` DOES NOT RUN SERIALLY -- pytest exits 4 with "unrecognized
  # arguments: -n 8 --dist loadgroup" having run ZERO tests, which was reported as "e2e tests
  # failed" (2026-08-12) and sent the reader hunting for a broken test that did not exist.
  # ⇒ DEGRADE, NAMING THE PACKAGE, RATHER THAN BLOCK OR GUESS. Serial is slower (~17 min against
  # ~4) and never wrong, and a host that cannot install a plugin should still push behind a gate
  # that RUNS. Measured on chicken 2026-09-18: the `nett-private` venv has no xdist, so under the
  # old rule an activated one blocked every push from a 4-GPU node.
  if [ "$1" -gt 1 ] && [ "${2:-0}" != 1 ]; then
    echo "pre-push: ⚠ pytest-xdist is NOT importable from" >&2
    echo "    ${PY:-<interpreter>}" >&2
    echo "  so the $1-way parallel e2e path is unavailable; degrading to NETT_E2E_JOBS=1" >&2
    echo "  (serial, ~17 min instead of ~4). The gate still runs IN FULL." >&2
    echo "  Install it with:  ${PY:-<python>} -m pip install -e '${SRC:-<src_isaac>}[test]'" >&2
    printf '1'
    return 0
  fi
  printf '%s' "$1"
}

e2e_verdict() {
  # Did the e2e leg RUN, or did it merely exit 0? Sets E2E_PASSED / E2E_SKIPPED; rc 1 = blocked.
  #
  # ⛔⛔ THE DEFECT THIS EXISTS FOR: "20 skipped in 1.60s" is rc 0, and for months every green
  # e2e line this hook printed on chicken was that. A gate that reports success without
  # executing is worse than no gate, because it also retires the suspicion that would have
  # caught it. Two rules, and the first is the precise one:
  #   * the tree-wide prerequisite gate fired => the HARNESS refused, and however many tests
  #     "passed", the ones it skipped were never run. tests/e2e/conftest.py marks them with
  #     the literal reason matched below, so this is a signature and not a heuristic;
  #   * zero passed => nothing ran at all. Every test here is a real training run.
  # A per-test skip (a missing FULL design sheet, say) is a different animal -- a deliberate
  # asset guard, not a broken harness -- so it warns loudly and does not block. Blocking on it
  # would teach --no-verify, which is how a gate dies.
  local log="$1" summary prereq
  summary="$(grep -aE '[0-9]+ (passed|failed|skipped|error|deselected)' "$log" 2>/dev/null \
             | tail -1 | sed 's/\x1b\[[0-9;]*m//g')"
  E2E_PASSED="$(printf '%s' "$summary" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+')"
  E2E_SKIPPED="$(printf '%s' "$summary" | grep -oE '[0-9]+ skipped' | grep -oE '[0-9]+')"
  [ -n "$E2E_PASSED" ] || E2E_PASSED=0
  [ -n "$E2E_SKIPPED" ] || E2E_SKIPPED=0
  # ⚠ grep -c PRINTS 0 and EXITS 1 when it matches nothing, so `|| echo 0` would append a
  # SECOND zero and make "0" into "0 0". The substitution already has the value.
  prereq="$(grep -ac 'e2e prerequisites missing' "$log" 2>/dev/null)"
  case "$prereq" in ''|*[!0-9]*) prereq=0 ;; esac
  echo "pre-push: e2e ran ${E2E_PASSED} training test(s), skipped ${E2E_SKIPPED}${summary:+  [${summary}]}"
  if [ "$prereq" -gt 0 ]; then
    echo "pre-push: BLOCKED -- the e2e HARNESS refused: tests/e2e's prerequisite gate fired," >&2
    echo "  so those tests were marked skip at collection and never ran. This exits 0 from" >&2
    echo "  pytest and is exactly the silent rot this gate exists to stop." >&2
    grep -aE 'e2e prerequisites missing' "$log" | head -3 >&2
    return 1
  fi
  if [ "$E2E_PASSED" -eq 0 ]; then
    echo "pre-push: BLOCKED -- the e2e tree exited 0 but NOTHING RAN: ${summary:-<no summary line>}" >&2
    echo "  Every test in this tree is a real training run, so zero passed means the harness" >&2
    echo "  refused, not that the code is good. Skip reasons:" >&2
    grep -aE "^SKIPPED" "$log" | head -10 >&2
    return 1
  fi
  if [ "$E2E_SKIPPED" -gt 0 ]; then
    echo "pre-push: ⚠ ${E2E_SKIPPED} e2e test(s) SKIPPED -- that part of the gate did not run:" >&2
    grep -aE "^SKIPPED" "$log" | head -5 >&2
  fi
  return 0
}

# --- self-test ------------------------------------------------------------------------
# `scripts/hooks/pre-push --self-test` -- git never passes this ($1 is the remote name), and it
# exits before the hook touches a repository, an interpreter or a GPU.
if [ "${1:-}" = "--self-test" ]; then
  _st_fail=0
  _st() { if [ "$1" = ok ]; then echo "  ok   $2"; else echo "  FAIL $2"; _st_fail=1; fi; }
  _t="$(mktemp -d)"; trap 'rm -rf "$_t"' EXIT
  # (1) the library predicate, on a good and a bad library -- synthetic first, so the test
  #     means the same thing on a host that has neither of the real ones.
  printf 'GLIBCXX_3.4.29\nGLIBCXX_3.4.30\n' > "$_t/good.so"
  printf 'GLIBCXX_3.4.28\nGLIBCXX_3.4.29\n' > "$_t/bad.so"
  _has_glibcxx_3_4_30 "$_t/good.so" && _st ok "good library recognised" || _st no "good library recognised"
  _has_glibcxx_3_4_30 "$_t/bad.so" && _st no "bad library rejected" || _st ok "bad library rejected"
  _has_glibcxx_3_4_30 "$_t/absent.so" && _st no "absent library rejected" || _st ok "absent library rejected"
  # and on the real pair, when this host has them: a predicate that passes on fixtures and
  # disagrees with the loader is worth nothing.
  for _real in /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib64/libstdc++.so.6; do
    [ -e "$_real" ] || continue
    if _has_glibcxx_3_4_30 "$_real"; then echo "  info $_real HAS GLIBCXX_3.4.30 (would be preloaded)"
    else echo "  info $_real lacks GLIBCXX_3.4.30 (this host cannot repair it that way)"; fi
  done
  _sys="$(_system_libstdcxx)" && echo "  info system libstdc++ resolves to $_sys" \
                              || echo "  info no system libstdc++ provides GLIBCXX_3.4.30"
  # ⚠ AND THE LIVE DECISION, DRY, when an interpreter is named: `--self-test <python>` reports
  # which library that python actually maps and which branch the e2e leg would take. The
  # synthetic pair above proves the predicate; this proves it against the library the loader
  # really picks, which is the only one that can skip the gate.
  if [ -n "${2:-}" ]; then
    _m="$(_mapped_libstdcxx "$2")"
    if [ -z "$_m" ]; then
      echo "  info $2 -> libstdc++ undeterminable; the hook would apply NO preload"
    elif _has_glibcxx_3_4_30 "$_m"; then
      echo "  info $2 -> maps $_m, which HAS GLIBCXX_3.4.30; the hook would apply NO preload"
    else
      echo "  info $2 -> maps $_m, which LACKS GLIBCXX_3.4.30; the hook would preload ${_sys:-<nothing available>}"
    fi
  fi
  # (2) the e2e verdict, on the four shapes of log that matter
  printf 'SKIPPED [20] tests/e2e/conftest.py:341: e2e prerequisites missing: isaacsim import failed: bootstrap\n20 skipped in 1.60s\n' > "$_t/rot.log"
  printf '20 passed, 3 deselected, 15 warnings in 935.89s (0:15:35)\n' > "$_t/real.log"
  printf 'SKIPPED [1] tests/e2e/test_full_run.py:129: full design sheet not found\n19 passed, 1 skipped in 900.00s\n' > "$_t/partial.log"
  : > "$_t/empty.log"
  e2e_verdict "$_t/rot.log"     >/dev/null 2>&1 && _st no "all-skipped log BLOCKS" || _st ok "all-skipped log BLOCKS"
  e2e_verdict "$_t/real.log"    >/dev/null 2>&1 && _st ok "a real 20-passed run is accepted" || _st no "a real 20-passed run is accepted"
  [ "${E2E_PASSED:-}" = 20 ] && _st ok "the passed count is read (20)" || _st no "the passed count is read (20)"
  e2e_verdict "$_t/partial.log" >/dev/null 2>&1 && _st ok "a per-test asset skip warns, does not block" || _st no "a per-test asset skip warns, does not block"
  [ "${E2E_SKIPPED:-}" = 1 ] && _st ok "the skipped count is read (1)" || _st no "the skipped count is read (1)"
  e2e_verdict "$_t/empty.log"   >/dev/null 2>&1 && _st no "an empty log BLOCKS" || _st ok "an empty log BLOCKS"
  # (3) the xdist degrade, in both directions -- including the one that must NOT fire
  [ "$(e2e_jobs_for_plugin 4 1 2>/dev/null)" = 4 ] && _st ok "4 GPUs + xdist stays 4-way" || _st no "4 GPUs + xdist stays 4-way"
  [ "$(e2e_jobs_for_plugin 4 0 2>/dev/null)" = 1 ] && _st ok "4 GPUs, no xdist degrades to serial" || _st no "4 GPUs, no xdist degrades to serial"
  [ "$(e2e_jobs_for_plugin 1 0 2>/dev/null)" = 1 ] && _st ok "1 GPU, no xdist is untouched (no -n was coming)" || _st no "1 GPU, no xdist is untouched"
  e2e_jobs_for_plugin 4 0 2>&1 >/dev/null | grep -q "pytest-xdist" && _st ok "the degrade NAMES the missing package" || _st no "the degrade NAMES the missing package"
  [ "$_st_fail" -eq 0 ] && echo "pre-push --self-test: OK" || echo "pre-push --self-test: FAILED" >&2
  exit "$_st_fail"
fi

ROOT="$(git rev-parse --show-toplevel)"
SRC="$ROOT/src_isaac"
WORKSPACE="$(cd "$ROOT/.." && pwd)"

# ⚠ TWO PATHS, AND THEY MEAN DIFFERENT THINGS. Getting either wrong produces failures that
# look like real defects:
#   * PYTHONPATH needs repoA's `source/` so `nett_isaac` imports.
#   * NETT_REPO_A must be the repoA REPOSITORY ROOT -- the directory CONTAINING isaac_lab/,
#     NOT isaac_lab/ itself. Point it one level too deep and tests/_repo_paths.py builds
#     `.../isaac_lab/isaac_lab/...` and 15 cross-repo tests fail with "expected source file
#     missing", which reads as a broken wiring rather than a bad env var. (Measured
#     2026-07-27 -- this exact mistake.)
REPO_A="${NETT_REPO_A:-$WORKSPACE/NewbornEmbodiedTuringTest_Private}"
if [ ! -d "$REPO_A/isaac_lab" ]; then
  echo "pre-push: repoA not found at $REPO_A (needs to contain isaac_lab/) -- set NETT_REPO_A" >&2
  exit 1
fi
export NETT_REPO_A="$REPO_A"
export PYTHONPATH="$SRC:$REPO_A/isaac_lab/source"

# --- the interpreter ------------------------------------------------------------------
# ⚠ DO NOT PUT A SINGLE HARDCODED PATH BACK HERE. This hook used to default to one host's
# venv (`.../.venv/nett-private/bin/python`). On another host the venv is `nett_private`
# -- underscore -- and BOTH names exist, so the hardcoded one resolved to a real,
# executable, EMPTY interpreter. `[ -x "$PY" ]` passed and the suite died at collection on
# `ModuleNotFoundError: No module named 'psutil'`, which reads as a missing dependency
# rather than as the wrong python. Hence: discover candidates, then PROBE each by importing
# what the suite actually needs. An interpreter that cannot import them is not a candidate,
# however executable it is.
# ⚠ REQUIRED AND OPTIONAL IN ONE PROBE, not two. pytest-xdist is NOT required -- a
# single-GPU host never passes `-n` and must not be rejected for lacking a plugin it will not
# use -- but both legs below need to KNOW, and a second `$PY -c 'import xdist'` somewhere else
# is a second answer that can disagree with this one (and did: the unit leg degraded while the
# e2e leg blocked). The probe reports it; the legs read the report.
PROBE='import pytest, psutil, yaml, jsonschema, torch, skrl
try:
    import xdist  # optional: parallelism, never correctness
    _x = "1"
except Exception:
    _x = "0"
print("probe-ok xdist=" + _x)'
_probe_fail=""      # remembers WHY the last candidate was rejected, for the error message
_probe_caps=""      # ... and what the ACCEPTED one can do

py_ok() {
  [ -x "$1" ] || { _probe_fail="not executable"; _probe_caps=""; return 1; }
  local out
  out="$("$1" -c "$PROBE" 2>&1)"
  case "$out" in
    *probe-ok*) _probe_fail=""; _probe_caps="${out##*probe-ok }"; return 0 ;;
    *)          _probe_fail="$(printf '%s' "$out" | tail -1)"; _probe_caps=""; return 1 ;;
  esac
}

# NETT_PYTHON is an ANSWER, not a hint: if it is set and fails the probe, say so and stop
# rather than quietly running a different interpreter than the one that was named. Silent
# substitution is how you end up debugging the wrong venv.
if [ -n "${NETT_PYTHON:-}" ] && ! py_ok "$NETT_PYTHON"; then
  echo "pre-push: \$NETT_PYTHON=$NETT_PYTHON is unusable -- $_probe_fail" >&2
  echo "  it must import: $PROBE" >&2
  echo "  install the test extra: $NETT_PYTHON -m pip install -e '$SRC[test]'" >&2
  echo "  or unset NETT_PYTHON to let the hook discover a venv" >&2
  exit 1
fi

PY=""
REJECTED=""
# Candidate order: explicit override, then an active venv, then every venv in or beside the
# workspace, then whatever python is on PATH. The glob is what makes this host-agnostic --
# it finds `nett_private` and `nett-private` alike and lets the probe decide.
CANDIDATES=()
[ -n "${NETT_PYTHON:-}" ] && CANDIDATES+=("$NETT_PYTHON")
[ -n "${VIRTUAL_ENV:-}" ] && CANDIDATES+=("$VIRTUAL_ENV/bin/python")
for cand in "$WORKSPACE"/.venv*/bin/python "$WORKSPACE"/.venv/*/bin/python \
            "$(dirname "$WORKSPACE")"/.venv*/bin/python \
            "$(dirname "$WORKSPACE")"/.venv/*/bin/python; do
  [ -e "$cand" ] && CANDIDATES+=("$cand")
done
_syspy="$(command -v python3 2>/dev/null)"
[ -n "$_syspy" ] && CANDIDATES+=("$_syspy")

for cand in ${CANDIDATES[@]+"${CANDIDATES[@]}"}; do   # +expansion: empty array under set -u
  if py_ok "$cand"; then PY="$cand"; break; fi
  REJECTED="$REJECTED
  $cand -- $_probe_fail"
done

if [ -z "$PY" ]; then
  echo "pre-push: no usable python found. Each candidate failed to import one of:" >&2
  echo "  $PROBE" >&2
  echo "Candidates tried:$REJECTED" >&2
  echo "Set NETT_PYTHON to the venv from ../blueprint.md, or install the test extra:" >&2
  echo "  <venv>/bin/python -m pip install -e '$SRC[test]'" >&2
  exit 1
fi
case "$_probe_caps" in *xdist=1*) HAVE_XDIST=1 ;; *) HAVE_XDIST=0 ;; esac
echo "pre-push: python $PY (pytest-xdist: $([ "$HAVE_XDIST" = 1 ] && echo present || echo ABSENT))"

# --- native libs ----------------------------------------------------------------------
# libGLU.so.1 is absent from the system linker path on the NETT hosts and lives in a
# hand-built prefix OUTSIDE every repository. Drop it and libneuray fails to load, RTX
# dies, and the tiled camera throws "CUDA illegal memory access" ~15-20s into init -- a
# masquerading fault that reads as a driver or PhysX problem. Only prepend when the loader
# cannot already find it, so a host that ships GLU properly is left alone. (repoA's hook
# does the same; keep them in step.)
if ! ldconfig -p 2>/dev/null | grep -q 'libGLU\.so\.1'; then
  GLU_DIR="${NETT_GLU_DIR:-$HOME/glu_libs/lib}"
  if [ -e "$GLU_DIR/libGLU.so.1" ]; then
    export LD_LIBRARY_PATH="$GLU_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  else
    echo "pre-push: warning -- libGLU.so.1 not on the linker path and not at $GLU_DIR;" >&2
    echo "          GPU tests may die with a masquerading CUDA error (set NETT_GLU_DIR)" >&2
  fi
fi

cd "$SRC" || exit 1

# --- how many workers to spread the unit suite over --------------------------------
# The unit suite is WAIT-bound, not CPU-bound: ~80 CPU-seconds of real work spread over
# 168s of wall clock, the rest spent waiting out watchdog timeouts and process death.
# That parallelises almost perfectly -- but ONLY with threads pinned, which
# tests/conftest.py::_pin_math_threads does. Measured 2026-09-14 on chicken (96 cores):
#
#     serial, unpinned  168.2s      -n 8, unpinned  228.8s   <-- SLOWER THAN SERIAL
#     serial, pinned    166.4s      -n 8, pinned     55.5s
#     (-n 16 pinned: 50.0s -- diminishing; one 20s test floors the critical path)
#
# 8 is deliberately not `auto`: `auto` means one worker per logical core (96 here), which
# buys nothing past the 20s floor and multiplies per-worker interpreter startup.
UNIT_JOBS="${NETT_UNIT_JOBS:-8}"
_ucores=$(nproc 2>/dev/null || echo 1)
[ "$UNIT_JOBS" -gt "$_ucores" ] && UNIT_JOBS="$_ucores"

# ⚠ PROBE FOR xdist, exactly as the e2e block does, and DEGRADE rather than block. A
# pytest without the plugin does not run serially when handed `-n` -- it exits 4 with
# "unrecognized arguments" having run ZERO tests. The unit suite is only slower without
# xdist, never wrong, so a host missing it should still be able to push.
_unit_jobs_args=""
if [ "$UNIT_JOBS" -gt 1 ] && [ "$HAVE_XDIST" = 1 ]; then
  _unit_jobs_args="-n $UNIT_JOBS"
else
  UNIT_JOBS=1
fi

# -u here too: same buffering trap as the e2e block below, just cheaper to hit.
echo "pre-push: unit suite (${UNIT_JOBS} worker(s)) ..."
if ! timeout "${NETT_UNIT_TIMEOUT:-900}" "$PY" -u -m pytest tests -q $_unit_jobs_args \
        >/tmp/nett_repob_prepush.log 2>&1; then
  grep -E "^(FAILED|ERROR)" /tmp/nett_repob_prepush.log | head -15 >&2
  grep -E "[0-9]+ (passed|failed|error)" /tmp/nett_repob_prepush.log | tail -1 >&2
  echo "pre-push: BLOCKED -- unit tests failed (full log /tmp/nett_repob_prepush.log)" >&2
  exit 1
fi
grep -E "[0-9]+ (passed|failed|skipped|error)" /tmp/nett_repob_prepush.log | tail -1

# The e2e tree (markers e2e_isaac / e2e_perf) is deselected by addopts, so the run above
# does NOT cover it. It is included here rather than left out, because "excluded by default
# and therefore never run" is exactly how the repoA tests rotted.
#
# ⚠ THESE ARE REAL TRAINING RUNS -- minutes, not the ~4s they cost while the whole tree
# auto-skipped for want of stimuli. That skip is what the prepare step below removes, so
# this hook is now slow by design. NETT_SKIP_E2E=1 is the escape hatch.
if [ -z "${NETT_SKIP_E2E:-}" ]; then
  # ⛔ WITHOUT THIS THE WHOLE TREE SKIPS AND THE HOOK PRINTS OK. Importing isaacsim stops at
  # an interactive "Do you accept the EULA? (Yes/No)" prompt; under pytest's capture that read
  # fails, the e2e conftest catches it as "e2e prerequisites missing", and 23 tests SKIP in 1.8s
  # with rc 0. Measured 2026-09-09 on chicken: 23 skipped in 1.78s -> `pre-push: OK`. With this
  # set, the same tree boots Kit and runs (one test: 1 passed in 96s).
  # ⚠ The fleet already knew: tools/launch_arm.sh:181 and tools/node_setup.sh:105 both export it,
  # the latter with the comment "importing isaacsim without it stops at an interactive EULA
  # prompt". Every ARM was fine; only this hook was missing it, so the gate never gated.
  export OMNI_KIT_ACCEPT_EULA=YES
  # ⛔ AND THE SECOND REASON THE WHOLE TREE SKIPPED, WHICH THE EULA FIX DID NOT COVER. On this
  # host `import torch` maps miniconda's libstdc++.so.6.0.29 into the process BEFORE isaacsim
  # asks for one, and isaacsim/kit/libcarb.so needs GLIBCXX_3.4.30, which 6.0.29 does not
  # provide: "Unable to bootstrap inner kit kernel: .../libstdc++.so.6: version `GLIBCXX_3.4.30'
  # not found". conftest's prerequisite gate catches that as "isaacsim import failed" and marks
  # the tree skip, so the leg exits 0 in 1.6s. Reproduced three ways (chicken, 2026-09-17/18):
  #     python -c "import torch, isaacsim"  -> bootstrap failure
  #     python -c "import isaacsim"         -> OK          (torch is what loads the bad one)
  #     LD_PRELOAD=<system libstdc++> python -c "import torch, isaacsim" -> OK
  # ⛔ NO PATH VARIABLE FIXES AN ALREADY-RESIDENT LIBRARY. LD_LIBRARY_PATH changes where the
  # loader LOOKS; by the time isaacsim asks, the wrong one is already mapped. LD_PRELOAD is the
  # only lever that gets in first.
  # ⛔⛔ GATED ON THE CONDITION, NEVER ON THE HOST. `_mapped_libstdcxx` asks the interpreter
  # which file it actually ends up with, and the preload happens only when that file lacks the
  # symbol AND a system library has it. lion probes a different venv and has never measured
  # this; a host whose libstdc++ is already fine must not be handed a preload it does not need,
  # because then the first symptom of a wrong one is an unrelated crash inside Kit.
  _mapped_lib="$(_mapped_libstdcxx "$PY")"
  _sys_lib="$(_system_libstdcxx)"
  if [ -z "$_mapped_lib" ]; then
    echo "pre-push: libstdc++ check INCONCLUSIVE (no /proc/self/maps, or torch did not import);"
    echo "pre-push:   no preload applied. If the e2e leg skips, this is the first thing to check."
  elif _has_glibcxx_3_4_30 "$_mapped_lib"; then
    echo "pre-push: libstdc++ ok -- $_mapped_lib provides GLIBCXX_3.4.30; no preload needed."
  elif [ -n "$_sys_lib" ]; then
    export LD_PRELOAD="$_sys_lib${LD_PRELOAD:+:$LD_PRELOAD}"
    echo "pre-push: ⚠ $_mapped_lib (the one torch loads) LACKS GLIBCXX_3.4.30, which isaacsim's"
    echo "pre-push:   libcarb.so requires -- preloading $_sys_lib for the e2e leg only."
  else
    echo "pre-push: ⛔ $_mapped_lib lacks GLIBCXX_3.4.30 and NO system libstdc++ provides it" >&2
    echo "  either, so the e2e tree will not boot Kit on this host. Install a newer libstdc++," >&2
    echo "  or point the venv at one. The e2e verdict below will block the push rather than" >&2
    echo "  let this report as a pass." >&2
  fi
  # Build what the e2e tree needs from outside both repositories BEFORE running it: the
  # versioned USD assets are verified, and the frame cache (~/.cache/nett_frame_cache) is
  # compiled. Doing it here rather than letting the tests do it lazily is deliberate --
  # the lazy path builds under a cross-process flock, and a cold cache plus concurrent Kit
  # boots is a known deadlock. It is idempotent, so a warm cache costs a second.
  echo "pre-push: external prerequisites (assets + frame cache) ..."
  if ! "$PY" scripts/prepare_test_env.py >/tmp/nett_repob_prepush_prep.log 2>&1; then
    grep -E "ERROR" /tmp/nett_repob_prepush_prep.log | head -10 >&2
    echo "pre-push: BLOCKED -- prerequisites unavailable (full log /tmp/nett_repob_prepush_prep.log)" >&2
    exit 1
  fi
  tail -3 /tmp/nett_repob_prepush_prep.log

  # ⚠⚠ -u AND timeout ARE BOTH LOAD-BEARING, and the reason is a measured 50 minutes of
  # nothing (2026-07-29). This ran WITHOUT them, hit a wall-clock cap, was SIGTERMed, and
  # left a ZERO-BYTE log: pytest block-buffers stdout when it is a file, so everything it
  # had printed died in the buffer. A push-blocking hook that can hang and then say
  # nothing at all is worse than no hook. `-u` makes progress survive the kill; `timeout`
  # means a hang FAILS instead of blocking the push forever (repoA's hook already bounds
  # its workers for exactly this reason). NETT_E2E_TIMEOUT overrides the budget.
  #
  # -v not -q, deliberately: with one test per training run, "which test was I on when it
  # died" is the whole diagnostic, and the progress-dot line never flushes.
  # --- how many GPUs to spread the e2e tree over -------------------------------------
  # Every test in this tree is a real training run, so serialised on one card the 23 of
  # them cost ~17 min (measured). tests/e2e/conftest.py gives each xdist worker its OWN
  # gpu (PYTEST_XDIST_WORKER -> device index), so the wall clock becomes tests/GPUs rounds.
  # ⚠ ONE WORKER PER GPU, NOT MORE. Two Kit processes on one card contend for the same
  # Vulkan/RTX queue and VRAM does not scale linearly, so over-subscribing loses time.
  # ⛔⛔ COUNT THE CARDS THE WORKERS WILL ACTUALLY USE, NOT THE CARDS THE HOST HAS.
  # `nvidia-smi --query-gpu=index` IGNORES CUDA_VISIBLE_DEVICES; torch honours it. The device
  # map in tests/e2e/conftest.py::_e2e_device is `int(worker[2:]) % torch.cuda.device_count()`,
  # so counting with nvidia-smi and mapping with torch disagree the moment anyone masks:
  #     CUDA_VISIBLE_DEVICES=4,5,6,7   nvidia-smi -> 8 jobs,  torch -> 4 devices
  #     => 8 workers % 4 devices = TWO Kit processes per card, which the note above forbids.
  # Measured on chicken 2026-09-13 (4-card node, masked to 2): 4 jobs over 2 devices. ⇒ THE
  # MASK, WHICH IS THE OBVIOUS WAY TO KEEP THIS HOOK OFF RUNNING ARMS, SILENTLY CONVERTS A
  # COLLISION INTO AN OVER-SUBSCRIPTION. Deriving the job count from the SAME source as the
  # device map makes `CUDA_VISIBLE_DEVICES=...` sufficient on its own -- no second knob to
  # remember, which is the failure mode a warning would have left in place. (lion found it.)
  E2E_JOBS="${NETT_E2E_JOBS:-}"
  _visible="$("$PY" -c 'import torch;print(torch.cuda.device_count())' 2>/dev/null)"
  case "$_visible" in ''|*[!0-9]*) _visible="" ;; esac
  if [ -z "$E2E_JOBS" ]; then
    if [ -n "$_visible" ] && [ "$_visible" -ge 1 ]; then
      E2E_JOBS="$_visible"
    else
      # torch unavailable: fall back, but say so -- this is the path that cannot see a mask.
      E2E_JOBS="$(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | wc -l)"
      echo "pre-push: ⚠ torch device count unavailable; job count came from nvidia-smi, which" >&2
      echo "pre-push:   does NOT honour CUDA_VISIBLE_DEVICES. Set NETT_E2E_JOBS if you masked." >&2
    fi
    [ "$E2E_JOBS" -lt 1 ] 2>/dev/null && E2E_JOBS=1
  fi
  # ⛔ AND REFUSE AN EXPLICIT OVER-SUBSCRIPTION RATHER THAN SILENTLY HALVING THROUGHPUT.
  # An operator who sets NETT_E2E_JOBS above the visible count gets two Kit processes on a
  # card; the run still "passes", just slower and with contention that reads as flakiness.
  if [ -n "$_visible" ] && [ "$_visible" -ge 1 ] && [ "$E2E_JOBS" -gt "$_visible" ]; then
    echo "pre-push: ⛔ NETT_E2E_JOBS=$E2E_JOBS exceeds the $_visible visible GPU(s)." >&2
    echo "pre-push:    conftest maps worker gwN to card N % $_visible, so $E2E_JOBS workers would put" >&2
    echo "pre-push:    more than one Kit process on a card. Lower it, or widen CUDA_VISIBLE_DEVICES." >&2
    exit 1
  fi
  # The plugin answer comes from the interpreter probe above, so it is the SAME answer the unit
  # leg used; the decision itself is a function so `--self-test` can exercise both directions.
  E2E_JOBS="$(e2e_jobs_for_plugin "$E2E_JOBS" "$HAVE_XDIST")"
  # ⚠ THE DEGRADE ABOVE MUST COME FIRST: the budget below divides the cores by E2E_JOBS, so
  # computing it against a job count that is about to become 1 would hand a serial run
  # cores/8 threads and make the slow path slower still.
  # ⚠ EACH CELL MUST GET A CPU BUDGET OR THE PARALLEL RUN IS SLOWER THAN THE SERIAL ONE.
  # Kit's carb pool, torch's intra-op pool and the process pool each size themselves to
  # the WHOLE host per cell, so N cells oversubscribe the box N-fold and collapse. One
  # budget governs all three; cores/cells is the rule that produced the measured knee.
  if [ -z "${NETT_KIT_THREADS:-}" ] && [ "$E2E_JOBS" -gt 1 ]; then
    _cores="$(nproc 2>/dev/null || echo 8)"
    export NETT_KIT_THREADS="$(( _cores / E2E_JOBS ))"
    [ "$NETT_KIT_THREADS" -lt 2 ] && export NETT_KIT_THREADS=2
  fi

  # ⚠ e2e_perf IS DELIBERATELY NOT IN THE PUSH GATE. It asserts wall-clock throughput and
  # peak VRAM against benchmarks/golden.json, which makes it a MEASUREMENT, not a test of
  # the code being pushed -- so it fails for reasons that have nothing to do with the diff.
  # Measured 2026-07-29: a push was blocked at 26.80 vs 27.02 steps/s, i.e. 15.2% below a
  # baseline recorded on a DIFFERENT host against a 15% band -- a 0.8% miss, pure noise,
  # and the same gate passed on the same commit minutes earlier on an idle machine.
  # A benchmark that blocks pushes teaches people to use --no-verify, and it cannot run
  # under -n anyway (see the guard in test_perf.py). Run it deliberately instead:
  #     pytest tests/e2e -m e2e_perf          # serial, on an idle machine
  E2E_TIMEOUT="${NETT_E2E_TIMEOUT:-5400}"
  _jobs_args=""
  # --dist loadgroup, NOT loadfile: `loadfile` pins a whole FILE to one worker, and
  # test_full_run.py alone holds 5 heavy training runs, so it became the critical path --
  # measured 6m41 with loadfile, where the tree's total work over 8 GPUs should be ~3
  # rounds. `loadgroup` distributes per TEST but honours @pytest.mark.xdist_group, which
  # test_outputs.py uses to keep its 4 tests (sharing one module-scoped training run) on a
  # single worker instead of rebuilding that fixture four times.
  [ "$E2E_JOBS" -gt 1 ] && _jobs_args="-n $E2E_JOBS --dist loadgroup"
  # ⛔ THE PUSH'S CONNECTION IS ALREADY OPEN AND WILL NOW SIT IDLE FOR THE WHOLE RUN. git contacts
  # the remote for the ref advertisement BEFORE running this hook, so that socket idles for as long
  # as the e2e takes. Measured 2026-09-09 on an ssh remote: `20 passed in 916.09s`, `pre-push: OK`,
  # then "Connection to github.com closed by remote host" and git exited 141 (SIGPIPE) with NOTHING
  # pushed. ⚠ Worst case is not 916s: NETT_UNIT_TIMEOUT (900) + NETT_E2E_TIMEOUT (5400) = 6300s of
  # idle socket. That 5400 cap was itself chosen while this phase took 1.8s, so it was never a
  # number about anything.
  #
  # ⛔⛔ TEST THE TRANSPORT, NOT THE KNOB. The first version of this advisory fired whenever
  # GIT_SSH_COMMAND was unset. That is wrong in BOTH directions and was wrong on two of three nodes:
  #   - the remote may be https, where git never spawns ssh at all and the ssh remedy is a NO-OP --
  #     printing it there is worse than silence, because the reader applies it and dies anyway with
  #     a green line above the corpse (both nodes' repoA `origin` is https);
  #   - ~/.ssh/config may already set ServerAliveInterval, so the advice is redundant;
  #   - GIT_SSH_COMMAND='ssh -v' suppresses the advisory while providing zero keepalive.
  # `ssh -G <host>` is the RESOLVER: it reports the value that will actually be used, including
  # -o overrides and ~/.ssh/config. Verified 2026-09-09: bare `ssh -G github.com` -> 0;
  # `ssh -o ServerAliveInterval=60 -G github.com` -> 60. (lion's diagnosis.)
  _rurl="${2:-${1:-}}"
  case "$_rurl" in
    ssh://*)                                  _rxport=ssh ;;
    http://*|https://*)                       _rxport=http ;;
    git://*|ftp://*|ftps://*|file://*|/*|.*|~*) _rxport=other ;;
    */*:*)                                    _rxport=other ;;
    *:*)                                      _rxport=ssh ;;
    *)                                        _rxport=other ;;
  esac
  if [ "$_rxport" = ssh ]; then
    case "$_rurl" in ssh://*) _rhost=${_rurl#ssh://}; _rhost=${_rhost%%/*} ;; *) _rhost=${_rurl%%:*} ;; esac
    _rhost=${_rhost#*@}
    case "$_rhost" in \[*\]*) _rhost=${_rhost#\[}; _rhost=${_rhost%%\]*} ;; *:*) _rhost=${_rhost%%:*} ;; esac
    # ⛔ GIT'S SSH RESOLVER IS A CHAIN, NOT A VARIABLE: GIT_SSH_COMMAND -> core.sshCommand ->
    # GIT_SSH -> ssh. Reading only the env var probes BARE SSH on any host that sets
    # core.sshCommand -- a different program than the one git will run -- and then reports that
    # other program's keepalive. (lion reproduced both branches with logging stub scripts.)
    _sshcmd="${GIT_SSH_COMMAND:-$(git config --get core.sshCommand 2>/dev/null)}"
    _sshcmd="${_sshcmd:-${GIT_SSH:-ssh}}"
    # ⚠ GIT_SSH is where a non-OpenSSH client lives (plink has no -G), so a failed probe is the
    # UNRESOLVED case and must advise, never be read as a zero. Captured without a pipeline so the
    # status is the ssh probe's own and not awk's.
    # unquoted on purpose: the command carries its own options and must word-split
    _graw=$(${_sshcmd} -G "$_rhost" 2>/dev/null); _grc=$?
    if [ "$_grc" -ne 0 ] || [ -z "$_graw" ]; then
      _alive=""
    else
      _alive=$(printf '%s\n' "$_graw" | awk '/^serveraliveinterval /{print $2; exit}')
    fi
    if [ -z "$_alive" ] || [ "$_alive" = 0 ]; then
      echo "pre-push: ⚠ ssh keepalives are OFF for $_rhost (serveraliveinterval ${_alive:-unresolved})," >&2
      echo "  and this phase idles the push's socket for up to $((${NETT_UNIT_TIMEOUT:-900} + E2E_TIMEOUT))s." >&2
      echo "  If the push dies with 'Connection ... closed by remote host' (exit 141) AFTER this" >&2
      echo "  passes, re-run with:" >&2
      echo "      GIT_SSH_COMMAND='ssh -o ServerAliveInterval=60 -o ServerAliveCountMax=30' git push ..." >&2
    fi
  elif [ "$_rxport" = http ]; then
    echo "pre-push: ⚠ remote is https, so the ssh keepalive remedy DOES NOT APPLY here." >&2
    echo "  ⛔ UNTESTED either way: git-remote-https does the ref advertisement as a separate GET" >&2
    echo "     and reopens for the POST, so it may not fail the way ssh does -- nobody has run it" >&2
    echo "     long enough to find out. ⛔ AND THE REMEDY IS UNTESTED TOO: http.lowSpeedLimit /" >&2
    echo "     http.lowSpeedTime are the first knobs to LOOK AT, not a verified cure -- nobody has" >&2
    echo "     confirmed they help, and naming an unverified remedy without saying so is how the" >&2
    echo "     ssh advisory above got shipped wrong. Do not assume this transport is safe." >&2
  fi
  echo "pre-push: e2e tree (real training runs; ${E2E_JOBS} gpu(s), kit_threads=${NETT_KIT_THREADS:-default}, cap ${E2E_TIMEOUT}s) ..."
  timeout "$E2E_TIMEOUT" "$PY" -u -m pytest tests/e2e -v -m "e2e_isaac and not e2e_perf" \
          -rs --tb=short $_jobs_args >/tmp/nett_repob_prepush_e2e.log 2>&1
  _e2e_rc=$?
  if [ "$_e2e_rc" -ne 0 ]; then
    if [ "$_e2e_rc" -eq 124 ]; then
      echo "pre-push: BLOCKED -- e2e exceeded ${E2E_TIMEOUT}s and was killed." >&2
      echo "  last test reached:" >&2
      grep -E "^tests/e2e.*(PASSED|FAILED|ERROR|SKIPPED)" \
          /tmp/nett_repob_prepush_e2e.log | tail -3 >&2
      # A killed pytest orphans its Isaac workers: they are reparented to PID 1 and keep
      # holding GPU memory indefinitely. Naming them beats leaving them to be found later
      # by a run that mysteriously cannot allocate.
      echo "  ⚠ check for orphaned Isaac workers still holding a GPU:" >&2
      echo "      nvidia-smi --query-compute-apps=pid,used_memory --format=csv" >&2
      echo "    reap with SIGTERM first; a Kit process that is WEDGED should be" >&2
      echo "    diagnosed, not -9'd (repeated SIGKILL of wedged boots can leave the" >&2
      echo "    driver in a bad state across all GPUs)." >&2
    elif [ "$_e2e_rc" -eq 1 ]; then
      grep -E "^(FAILED|ERROR)" /tmp/nett_repob_prepush_e2e.log | head -15 >&2
      grep -E "[0-9]+ (passed|failed|error)" /tmp/nett_repob_prepush_e2e.log | tail -1 >&2
      echo "pre-push: BLOCKED -- e2e tests failed" >&2
    else
      # ⚠ NOT A TEST FAILURE. pytest reserves 2=interrupted, 3=internal error, 4=bad
      # command line, 5=nothing collected -- in every one of these the tree did not run, so
      # saying "tests failed" points the reader at the diff instead of at the harness. A rc
      # 4 from a missing pytest-xdist was misread exactly that way (2026-08-12); rc 5 means
      # the e2e tree collected NOTHING, which is the silent-skip rot the hook exists to
      # catch and must never be mistaken for a pass.
      case "$_e2e_rc" in
        2) _why="pytest was interrupted (SIGINT/SIGTERM)" ;;
        3) _why="pytest hit an INTERNAL error" ;;
        4) _why="pytest rejected the command line (missing plugin? bad marker?)" ;;
        5) _why="pytest collected NO tests -- the e2e tree selected nothing" ;;
        *) _why="pytest exited $_e2e_rc" ;;
      esac
      echo "pre-push: BLOCKED -- the e2e tree did not run: $_why" >&2
      echo "  This is a HARNESS problem, not a failing test. First 15 lines:" >&2
      head -15 /tmp/nett_repob_prepush_e2e.log >&2
    fi
    echo "  full log: /tmp/nett_repob_prepush_e2e.log" >&2
    exit 1
  fi
  # ⛔ rc 0 IS NOT EVIDENCE THE TREE RAN -- see `e2e_verdict`, which is where that judgement
  # lives so that it can be tested without a push (`scripts/hooks/pre-push --self-test`).
  if ! e2e_verdict /tmp/nett_repob_prepush_e2e.log; then
    echo "  full log: /tmp/nett_repob_prepush_e2e.log" >&2
    exit 1
  fi
  _gate="unit + e2e (${E2E_PASSED} real training run(s))"
else
  # ⛔ AND A SKIPPED e2e MUST NOT READ AS A PASS EITHER. This branch printed nothing at all and
  # then "pre-push: OK", so a push gated by the unit suite alone was indistinguishable in the
  # output from one that had run 15 minutes of training. Same defect as the silent all-skip,
  # one level up.
  echo "pre-push: ⚠⚠ e2e SKIPPED by NETT_SKIP_E2E -- NO training test ran." >&2
  echo "  This push is gated by the unit suite ALONE. Unset NETT_SKIP_E2E to gate for real." >&2
  _gate="unit ONLY -- e2e skipped by NETT_SKIP_E2E"
fi

# ⚠ THE FINAL LINE NAMES WHAT GATED, because "pre-push: OK" is the only line most readers keep,
# and it has to be able to say the e2e did not run.
echo "pre-push: OK ($_gate)"
exit 0
